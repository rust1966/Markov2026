    "import numpy as np\n",
    "\n",
    "#Need to create matrix p\n",
    "p = np.array([\n",
    "    [0.9, 0.1, 0],\n",
    "    [0, 0.75, 0.25],\n",
    "    [0.5, 0, 0.5]\n",
    "])\n",
    "\n",
    "#Raise p^50\n",
    "p_50 = np.linalg.matrix_power(p, 50)\n",
    "print(p_50)"
   ]
  }
